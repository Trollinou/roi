{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 2,
  "name": "roi/pgn",
  "version": "1.9.0",
  "title": "Partie PGN ROI",
  "category": "widgets",
  "icon": "book-alt",
  "description": "Affichage d'une partie d'échecs au format PGN.",
  "supports": {
    "html": false,
    "blockBindings": true,
    "interactivity": true,
    "align": [
      "wide",
      "full"
    ]
  },
  "attributes": {
    "pgn": {
      "type": "string",
      "default": ""
    },
    "orientation": {
      "type": "string",
      "default": "white"
    }
  },
  "textdomain": "roi",
  "editorScript": "file:./index.js",
  "editorStyle": [
    "file:./chessboard-style.css",
    "file:./index.css"
  ],
  "style": [
    "file:./chessboard-style.css",
    "file:./index.css"
  ],
  "viewScriptModule": "file:./pgn-view.js"
}
