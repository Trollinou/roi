{
  "name": "roi",
  "version": "1.9.0",
  "types": "./src/types/index.ts",
  "exports": {
    ".": {
      "types": "./src/types/index.ts"
    },
    "./types": {
      "types": "./src/types/index.ts"
    },
    "./*": {
      "types": "./src/types/*.ts"
    }
  },
  "scripts": {
    "build:blocks": "wp-scripts build",
    "build:js": "node scripts/build-js.js",
    "build:css": "node scripts/build-css.js",
    "build": "npm run build:blocks && npm run build:js && npm run build:css",
    "start": "wp-scripts start",
    "typecheck": "tsc --noEmit",
    "package": "node scripts/package.cjs",
    "version-sync": "node scripts/version-sync.cjs",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@wordpress/eslint-plugin": "^25.8.0",
    "@wordpress/scripts": "^34.0.0",
    "chessops": "^0.15.1",
    "copy-webpack-plugin": "^14.0.0",
    "esbuild": "^0.28.2",
    "react": "^18.3.1",
    "rtlcss": "^4.3.0",
    "sass": "^1.105.1",
    "typescript": "^6.x.x"
  },
  "dependencies": {
    "eg-chessboard": "file:../eg-chessboard"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true,
    "fsevents": true,
    "@parcel/watcher@2.6.0": true,
    "core-js-pure@3.50.0": true,
    "core-js@3.50.0": true
  },
  "overrides": {
    "react": "^18.3.1"
  }
}
