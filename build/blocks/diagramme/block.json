{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 2,
  "name": "roi/diagramme",
  "version": "1.3.1",
  "title": "Diagramme ROI",
  "category": "widgets",
  "icon": "grid-view",
  "description": "Affichage d'un diagramme d'échecs (FEN).",
  "supports": {
    "align": [
      "wide",
      "full"
    ]
  },
  "attributes": {
    "fen": {
      "type": "string",
      "default": "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1"
    },
    "orientation": {
      "type": "string",
      "default": "white"
    },
    "shapes": {
      "type": "array",
      "default": []
    }
  },
  "textdomain": "roi",
  "editorScript": "file:./index.js"
}