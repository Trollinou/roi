{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 2,
    "name": "roi/chessboard",
    "title": "Échiquier",
    "category": "widgets",
    "icon": "grid-view",
    "description": "Insérer un échiquier interactif",
    "attributes": {
        "fen": {
            "type": "string",
            "default": "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1"
        },
        "turn": {
            "type": "string",
            "default": "w"
        },
        "orientation": {
            "type": "string",
            "default": "white"
        },
        "engineElo": {
            "type": "number",
            "default": 1200
        },
        "enableEngine": {
            "type": "string",
            "default": "false"
        },
        "enableMoves": {
            "type": "string",
            "default": "true"
        },
        "borderType": {
            "type": "string",
            "default": "frame"
        },
        "showCoordinates": {
            "type": "boolean",
            "default": true
        },
        "pieces": {
            "type": "string",
            "default": "standard"
        },
        "cssClass": {
            "type": "string",
            "default": "chessboard-js"
        }
    },
    "editorScript": "file:./chessboard-block.js",
    "editorStyle": [
        "file:./editor.css",
        "file:../../../vendor/cm-chessboard/assets/chessboard.css"
    ],
    "style": [
        "file:../../../vendor/cm-chessboard/assets/chessboard.css"
    ]
}
